{
  "name": "chatapp",
  "private": true,
  "scripts": {
    "lint": "eslint server/src client/src",
    "format": "prettier --write server/src client/src",
    "prepare": "husky"
  },
  "lint-staged": {
    "{server,client}/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  }
}
